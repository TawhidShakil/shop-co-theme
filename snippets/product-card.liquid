<div class="group flex flex-col gap-3 w-full">
  <a href="{{ product_item.url }}" class="relative aspect-square overflow-hidden rounded-[20px] bg-[#F0EEED]">
    {% if product_item.featured_image != blank %}
      <img 
        src="{{ product_item.featured_image | image_url: width: 600 }}" 
        alt="{{ product_item.title }}"
        class="h-full w-full object-contain p-4 transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        width="600"
        height="600"
      >
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'w-full h-full bg-gray-200' }}
    {% endif %}
  </a>

  <div class="flex flex-col gap-1 px-1">
    <h3 class="text-lg font-bold text-black tracking-tight leading-tight uppercase">
      <a href="{{ product_item.url }}">{{ product_item.title }}</a>
    </h3>
    <div class="flex items-center gap-2">
      <span class="text-[#FFC633]">★★★★☆</span>
      <span class="text-sm font-medium text-black">4.0/5</span>
    </div>
    <div class="flex items-center gap-3 mt-1">
      <span class="text-xl font-bold text-black">{{ product_item.price | money_without_trailing_zeros }}</span>
      {% if product_item.compare_at_price > product_item.price %}
        <span class="text-gray-400 line-through text-sm">{{ product_item.compare_at_price | money_without_trailing_zeros }}</span>
      {% endif %}
    </div>
  </div>
</div>