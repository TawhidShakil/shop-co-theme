<h1 class="text-3xl font-bold mb-8">Your Cart</h1>

<form action="{{ routes.cart_url }}" method="post">

  {% for item in cart.items %}
    <div class="flex gap-6 mb-6 border-b pb-6">
      
      <img src="{{ item.image | image_url: width: 200 }}" width="120">

      <div class="flex-1">
        <h2 class="text-lg font-semibold">{{ item.product.title }}</h2>
        <p>{{ item.variant.title }}</p>
        <p class="font-bold mt-2">{{ item.line_price | money }}</p>

        <input 
          type="number" 
          name="updates[]" 
          value="{{ item.quantity }}" 
          min="1"
          class="border w-20 mt-3"
        >

        <a href="{{ item.url_to_remove }}" class="text-red-500 block mt-2">
          Remove
        </a>
      </div>

    </div>
  {% endfor %}

  <div class="mt-10 text-right">
    <p class="text-xl font-bold">
      Total: {{ cart.total_price | money }}
    </p>

    <button 
      type="submit" 
      name="checkout"
      class="bg-black text-white px-8 py-4 rounded-xl mt-4"
    >
      Proceed to Checkout
    </button>
  </div>

</form>