{% schema %}
{
  "name": "Feature Collections",
  "settings": [
    {
      "type": "text",
      "id": "collection_title",
      "label": "Collection Title"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_shows",
      "label": "Number of Products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "product_shows_mobile",
      "label": "Number of Products on Mobile",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
        "type": "range",
        "id": "margin_top",
        "label": "Margin Top",
        "min": 20,
        "max": 100,
        "step": 1,
        "default": 72
    },
    {
        "type": "range",
        "id": "margin_bottom",
        "label": "Margin Bottom",
        "min": 20,
        "max": 100,
        "step": 1,
        "default": 64
    },
    {
        "type": "checkbox",
        "id": "bottom_border",
        "label": "Enable Bottom Border",
        "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}


<div class=" full-width">

    <div id="main" class="">
        <div id="title" class="">
            {% if section.settings.collection_title != blank %}
                <h1 class="font-integral text-collectionTitle-desktop">{{ section.settings.collection_title }}</h1>
            {% else %}
                <h1 class="font-integral text-collectionTitle-desktop">{{ section.settings.collection.title }}</h1>
            {% endif %} 
        </div>

        <div id="products" class="flex">
            {% for product in section.settings.collection.products limit: section.settings.product_shows %}
                <div class="product" data-index="{{ forloop.index }}">
                    <a href="{{ product.url }}" style="display: block;">
                        <img 
                            src="{{ product.featured_image | image_url: width: 295, height: 295 }}" 
                            alt="{{ product.title }}"
                            class="w-[295px] h-[295px] object-cover"
                            loading="lazy"
                        >
                    </a>

                    <h2 id="product-title" class="font-satoshi text-product-title-desktop">{{ product.title }}</h2>
                    <h2 id="product-rating">⭐4.9(120)</h2>
                    
                    
                    {% if product.compare_at_price > product.price %}
                        <div id="price-row">
    
                            <p id="current-price">
                                ${{ product.price | divided_by: 100 | floor }}
                            </p>

                            <p id="old-price">
                                ${{ product.compare_at_price | divided_by: 100 | floor }}
                            </p>

                            {% assign discount = product.compare_at_price | minus: product.price %}
                            {% assign discount_percentage = discount | times: 100 | divided_by: product.compare_at_price %}

                            <span id="discount-badge">
                                -{{ discount_percentage }}%
                            </span>

                        </div>
                    {% else %}
                        <p id="current-price">
                            ${{ product.price | divided_by: 100 | floor }}
                        </p>
                    {% endif %}


                </div>
            {% endfor %}
        </div>

        <div id="viewBtn">
            {% if section.settings.product_shows < section.settings.collection.products.size %}
                <a
                    id="view-all"
                    href="{{ section.settings.collection.url }}"
                >
                    View All
                </a>
            {% endif %}
        </div>
    </div>

   

</div>   



<style>

#main{
    padding-left: 100px;
    padding-right: 100px;

    padding-top: {{ section.settings.margin_top }}px;
    
    
   
}

#title{
    display: flex;
    justify-content: center;
    align-items: center;

    
}

#products{
    align-items: flex-start;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 55px;
}

.product {
    width: 295px;
}

#product-title{
    margin-top: 16px;
}

#product-rating{
    margin-top: 8px;
}

#product-price{
    margin-top: 8px;
}

#viewBtn{
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 60px;
    width: 100%;

    padding-bottom: {{ section.settings.margin_bottom }}px;
    {% if section.settings.bottom_border == true %}
        border-bottom: 1px solid #e6e6e6;
    {% endif %}
}

#view-all{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    width: 218px;
    border: 1px solid #d1cfcf;
    border-radius: 50px;
    font-family: "Satoshi", sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #000000;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
}

#view-all:hover {
    background-color: #000000;
    color: #ffffff;
    border-color: #000000;
}

/* // Price code  */

#price-row {
  display: flex;
  align-items: center;
  gap: 10px; /* space between prices */
}

#current-price {
  font-family: "Satoshi", sans-serif;
  font-size: 24px;
  font-weight: 700;
  color: #000000;
  margin: 0;
}

#old-price {
  font-family: "Satoshi", sans-serif;
  font-size: 24px;
  color: #9ca3af; /* gray */
  text-decoration: line-through;
  margin: 0;
}

#discount-badge {
  font-size: 14px;
  color: #ef4444;
  background-color: #fee2e2;
  padding: 2px 8px;
  border-radius: 999px; /* pill shape */
  font-weight: 500;
}



/* --------------------------- */
/* Mobile responsive code */

@media screen and (max-width: 768px){
    #main{
        padding-left: 20px;
        padding-right: 20px;
    }

    /* 2 products per row */
    .product {
        width: calc(50% - 10px);
    }

    /* Image fills the card, stays square */
    .product img {
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
    }

    /* Collection title */
    #title h1{
        font-size: var(--text-collectionTitle-mobile);
    }

    /* Product title */
    .product h2#product-title {
        font-size: var(--text-product-title-mobile);
    }

    /* Prices */
    #current-price {
        font-size: var(--text-product-price-mobile);
    }

    #old-price {
        font-size: var(--text-product-title-mobile);
    }
    /* Hide products beyond mobile limit */
    .product:nth-child(n+{{ section.settings.product_shows_mobile | plus: 1 }}) {
        display: none;
    }

    #view-all{
        width: 358px;
        height: 52px;
    }
}


</style>