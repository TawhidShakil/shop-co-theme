{% schema %}
{
  "name": "Feature Collections",
  "settings": [
    {
      "type": "text",
      "id": "collection_title",
      "label": "Collection Title"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_shows",
      "label": "Number of Products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "product_shows_mobile",
      "label": "Number of Products on Mobile",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
        "type": "range",
        "id": "margin_top",
        "label": "Margin Top",
        "min": 20,
        "max": 100,
        "step": 1,
        "default": 72
    },
    {
        "type": "range",
        "id": "margin_bottom",
        "label": "Margin Bottom",
        "min": 20,
        "max": 100,
        "step": 1,
        "default": 64
    },
    {
        "type": "checkbox",
        "id": "bottom_border",
        "label": "Enable Bottom Border",
        "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}


<div class="full-width">

    <div id="fc-main-{{ section.id }}">
        <div id="fc-title-{{ section.id }}">
            {% if section.settings.collection_title != blank %}
                <h1 class="font-integral text-collectionTitle-desktop">{{ section.settings.collection_title }}</h1>
            {% else %}
                <h1 class="font-integral text-collectionTitle-desktop">{{ section.settings.collection.title }}</h1>
            {% endif %} 
        </div>

        <div id="fc-products-{{ section.id }}" class="flex">
            {% for product in section.settings.collection.products limit: section.settings.product_shows %}
                <div class="fc-product-{{ section.id }}" data-index="{{ forloop.index }}">

                    <div class="w-full aspect-square">
                        <a href="{{ product.url }}" class="block w-full h-full">
                        <img 
                        src="{{ product.featured_image | image_url: width: 295, height: 295 }}" 
                        alt="{{ product.title | escape }}"
                        class="w-full h-full object-cover"
                        loading="lazy"
                        >
                        </a>
                    </div>

                    <h2 id="fc-product-title-{{ section.id }}" class="font-satoshi text-product-title-desktop">{{ product.title }}</h2>
                    <h2 id="fc-product-rating-{{ section.id }}">⭐4.9(120)</h2>
                    
                    
                    {% if product.compare_at_price > product.price %}
                        <div id="fc-price-row-{{ section.id }}">
    
                            <p id="fc-current-price-{{ section.id }}">
                                ${{ product.price | divided_by: 100 | floor }}
                            </p>

                            <p id="fc-old-price-{{ section.id }}">
                                ${{ product.compare_at_price | divided_by: 100 | floor }}
                            </p>

                            {% assign discount = product.compare_at_price | minus: product.price %}
                            {% assign discount_percentage = discount | times: 100 | divided_by: product.compare_at_price %}

                            <span id="fc-discount-badge-{{ section.id }}">
                                -{{ discount_percentage }}%
                            </span>

                        </div>
                    {% else %}
                        <p id="fc-current-price-{{ section.id }}">
                            ${{ product.price | divided_by: 100 | floor }}
                        </p>
                    {% endif %}


                </div>
            {% endfor %}
        </div>

        <div id="fc-viewBtn-{{ section.id }}">
            {% if section.settings.product_shows < section.settings.collection.products.size %}
                <a
                    id="fc-view-all-{{ section.id }}"
                    href="{{ section.settings.collection.url }}"
                >
                    View All
                </a>
            {% endif %}
        </div>
    </div>

   

</div>   



<style>

#fc-main-{{ section.id }}{
    padding-left: 100px;
    padding-right: 100px;
    padding-top: {{ section.settings.margin_top }}px;
}

#fc-title-{{ section.id }}{
    display: flex;
    justify-content: center;
    align-items: center;
}

#fc-products-{{ section.id }}{
    align-items: flex-start;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 55px;
}

.fc-product-{{ section.id }} {
    width: 295px;
}

#fc-product-title-{{ section.id }}{
    margin-top: 16px;
}

#fc-product-rating-{{ section.id }}{
    margin-top: 8px;
}

#fc-viewBtn-{{ section.id }}{
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 60px;
    width: 100%;
    padding-bottom: {{ section.settings.margin_bottom }}px;
    {% if section.settings.bottom_border == true %}
        border-bottom: 1px solid #e6e6e6;
    {% endif %}
}

#fc-view-all-{{ section.id }}{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    width: 218px;
    border: 1px solid #d1cfcf;
    border-radius: 50px;
    font-family: "Satoshi", sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #000000;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
}

#fc-view-all-{{ section.id }}:hover {
    background-color: #000000;
    color: #ffffff;
    border-color: #000000;
}

/* Price code */

#fc-price-row-{{ section.id }} {
  display: flex;
  align-items: center;
  gap: 10px;
}

#fc-current-price-{{ section.id }} {
  font-family: "Satoshi", sans-serif;
  font-size: 24px;
  font-weight: 700;
  color: #000000;
  margin: 0;
}

#fc-old-price-{{ section.id }} {
  font-family: "Satoshi", sans-serif;
  font-size: 24px;
  color: #9ca3af;
  text-decoration: line-through;
  margin: 0;
}

#fc-discount-badge-{{ section.id }} {
  font-size: 14px;
  color: #ef4444;
  background-color: #fee2e2;
  padding: 2px 8px;
  border-radius: 999px;
  font-weight: 500;
}



/* --------------------------- */
/* Mobile responsive code */

@media screen and (max-width: 768px){
    #fc-main-{{ section.id }}{
        padding-left: 20px;
        padding-right: 20px;
    }

    #fc-products-{{ section.id }}{
        gap: 16px;
    }

    /* 2 products per row */
    .fc-product-{{ section.id }} {
        width: calc((100% - 16px) / 2);
    }

    /* Image fills the card, stays square */
    .fc-product-{{ section.id }} img {
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
    }

    /* Collection title */
    #fc-title-{{ section.id }} h1{
        font-size: var(--text-collectionTitle-mobile);
    }

    /* Product title */
    .fc-product-{{ section.id }} h2#fc-product-title-{{ section.id }} {
        font-size: var(--text-product-title-mobile);
    }

    /* Prices */
    #fc-current-price-{{ section.id }} {
        font-size: var(--text-product-price-mobile);
    }

    #fc-old-price-{{ section.id }} {
        font-size: var(--text-product-title-mobile);
    }

    /* Hide products beyond mobile limit */
    .fc-product-{{ section.id }}:nth-child(n+{{ section.settings.product_shows_mobile | plus: 1 }}) {
        display: none;
    }

    #fc-view-all-{{ section.id }}{
        width: 358px;
        height: 52px;
    }
}


</style>