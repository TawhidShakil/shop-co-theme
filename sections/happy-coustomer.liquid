<section class="py-16 lg:py-24 bg-white overflow-hidden">
  <div class="max-w-[1440px] mx-auto">
    
    <!-- Header -->
    <div class="flex justify-between items-end mb-12 px-6 py-6">
      <h2 class="text-4xl lg:text-5xl  font-integral font-integral--weight tracking-wide  uppercase leading-none">
        {{ section.settings.title }}
      </h2>

      <div class="flex gap-4 mb-1">
        <button id="prev-{{ section.id }}" class="cursor-pointer hover:opacity-50 transition p-1">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2.5">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>
        <button id="next-{{ section.id }}" class="cursor-pointer hover:opacity-50 transition p-1">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2.5">
            <path d="M5 12h14m-7-7 7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Slider Wrapper -->
    <div class="relative w-full overflow-hidden px-6 lg:px-20">
      <div 
        id="slider-{{ section.id }}" 
        class="flex items-center gap-6 transition-transform duration-500 ease-in-out"
      >
        {% for block in section.blocks %}
          <div 
            class="review-card"
            {{ block.shopify_attributes }}
          >
            <!-- Stars -->
            <div class="text-[#FFC633] text-xl mb-4 tracking-wider">
              ★★★★★
            </div>
            
            <!-- Author -->
            <div class="flex items-center gap-2 mb-3">
              <span class="font-bold text-[20px]">
                {{ block.settings.author_name }}
              </span>

              <div class="bg-[#01AB31] rounded-full w-5 h-5 flex items-center justify-center">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="white">
                  <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                </svg>
              </div>
            </div>

            <!-- Review -->
            <p class="text-gray-500 text-[16px] leading-[1.6]">
              "{{ block.settings.review_text }}"
            </p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
.review-card {
  width: 320px;
  height: 240px;
  border-radius: 20px;
  border: 1px solid #E5E7EB;
  padding: 28px 32px;
  background: #ffffff;
  flex-shrink: 0;
  opacity: 0.3;
  transform: scale(0.9);
  filter: blur(2px);
  transition: all 0.4s ease;
}

.review-card.active {
  opacity: 1;
  transform: scale(1);
  filter: blur(0);
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {

  const slider = document.getElementById('slider-{{ section.id }}');
  const cards = slider.querySelectorAll('.review-card');
  const next = document.getElementById('next-{{ section.id }}');
  const prev = document.getElementById('prev-{{ section.id }}');

  if (!slider || cards.length === 0) return;

  let currentIndex = 3; 

  function updateSlider() {

    const cardWidth = 320 + 20; 
    const containerWidth = slider.parentElement.offsetWidth;
    const offset = (containerWidth / 2) - (320 / 2);

    slider.style.transform =
      `translateX(${-currentIndex * cardWidth + offset}px)`;

    cards.forEach((card, index) => {
      card.classList.remove('active');

      // 3 ta card active
      if (
        index === currentIndex ||
        index === currentIndex - 1 ||
        index === currentIndex + 1
      ) {
        card.classList.add('active');
      }
    });
  }

  next.addEventListener('click', () => {
    if (currentIndex < cards.length - 2) {
      currentIndex++;
      updateSlider();
    }
  });

  prev.addEventListener('click', () => {
    if (currentIndex > 1) {
      currentIndex--;
      updateSlider();
    }
  });

  window.addEventListener('resize', updateSlider);

  updateSlider();
});
</script>
{% schema %}
{
  "name": "Customized Reviews",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "OUR HAPPY CUSTOMERS"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "author_name",
          "label": "Name",
          "default": "Sarah M."
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review",
          "default": "I'm blown away by the quality and style..."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Happy Coustomer",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}