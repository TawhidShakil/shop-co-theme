<section class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-6" id="ProductSection-{{ section.id }}">
  
  <!-- Breadcrumb -->
  <nav class="flex text-sm text-gray-400 mb-6 space-x-2">
    <a href="/" class="hover:text-black transition">Home</a>
    <span>›</span>
    <a href="/collections/all" class=" gap-4 hover:text-black transition ">Shop</a>
    <span class="gap-4">›</span>
    
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-10">

    <!-- LEFT: Images -->
    <div class="flex flex-col-reverse md:flex-row gap-4">

      <!-- Thumbnails -->
      <div class="flex md:flex-col gap-3 w-full md:w-20 overflow-x-auto">
         {% for image in product.images %}
          <button 
            class="thumbnail-btn flex-shrink-0 border-2 rounded-xl overflow-hidden transition-all duration-200 {% if forloop.first %}border-black{% else %}border-transparent{% endif %}"
            data-image-url="{{ image | img_url: '800x' }}">
            <img src="{{ image | img_url: '150x150', crop: 'center' }}" alt="{{ image.alt }}" class="w-16 h-16 md:w-full md:h-20 object-cover">
          </button>
        {% endfor %}
      </div>

      <!-- Main Image -->
      <div class="flex-  rounded-3xl">
        <img
          id="MainProductImage"
          src="{{ product.featured_image | img_url: '1200x' }}"
          alt="{{ product.title }}"
          class="w-full h-full"
        >
      </div>
    </div>

    <!-- RIGHT: Product Info -->
    <div class= "flex flex-col justify-start gap-2">

      <!-- Title -->
      <h1 class="font-integral text-[40px]  font-integral--color  leading-tight text-product-title-desktop--line-height">
        {{ product.title }}
        

      </h1>

      <!-- Rating -->

      
     <div class="flex items-center gap-2 w-[139px] h-[24px]">
    <div class="flex text-yellow-400">
      {% for i in (1..5) %}
        <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
      {% endfor %}
    </div>
    <span class="text-gray-500 text-sm">4.5/5</span>
  </div>

      <!-- Price -->
      <div class="flex items-center gap-4 py-1">
    <span class="text-product-price-desktop font-satoshi font-satoshi--weight text-[32px] leading-none">
      {{ product.price | money }}
    </span>

    {% if product.compare_at_price > product.price %}
      <span class="text-gray-400 line-through text-[32px] font-satoshi-discount leading-none">
        {{ product.compare_at_price | money }}
      </span>

      <span class="bg-red-100 text-red-500 text-sm px-3 py-1 rounded-full font-satoshi-percentage">
        -{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%
      </span>
    {% endif %}
  </div>

  <p class="text-gray-500 text-[16px] leading-snug w-[590px] mt-1">
    {{ product.description | strip_html | truncatewords: 30 }}
  </p>

  <hr class="border-t-4 border-gray-200 w-[590px] mb-4 mt-4">

      <!-- Product Form -->
      {% form 'product', product, class: 'product-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        {% for option in product.options_with_values %}
          <div class=" flex flex-col justify-start gap-1">
            <h3 class=" text-[16px] w-[93px] h-[11px]  text-gray-500 gap-4">
              {{ option.name }}
            </h3>

            <div class="flex items-center gap-4 mt-4 mb-4  py-8 ">
              {% for value in option.values %}
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="{{ option.name }}"
                    value="{{ value }}"
                    class="hidden peer justify-between  gap-4"
                    {% if option.selected_value == value %}checked{% endif %}
                  >

                  {% if option.name contains 'Color' or option.name contains 'Colour' %}
                    <span
                      class="w-10 h-10 rounded-full border  border-gray-200 ring-2 ring-transparent ring-offset-2 peer-checked:ring-black block"
                      style="background-color: {{ value | handle }};">
                    </span>
                  {% else %}
                    <span class=" px-4 py-3 bg-gray-100 rounded-full text-[16px] text-gray-700 peer-checked:bg-black peer-checked:text-white">
                      {{ value }}
                    </span>
                  {% endif %}
                </label>
              {% endfor %}
            </div>
          </div>
        {% endfor %}

        <hr class="border-gray-200 mb-6 py-4">

        <!-- Quantity + Button -->
        <div class="flex flex-row gap-4">

          <!-- Quantity -->
          <div class="flex items-center w-[170px] justify-between bg-gray-100 rounded-full h-[52px] ml-4 gap-4 sm:w-[170px] px-6">
            <button type="button" data-qty-btn="minus" class="text-[16px] font-bold">−</button>
            <input type="number" name="quantity" value="1" min="1" class="bg-transparent text-[16px] text-center w-12 border-none focus:ring-0 font-semibold">
            <button type="button" data-qty-btn="plus" class="text-[16px] font-bold">+</button>
          </div>

          <!-- Add to Cart -->
          <button
            type="submit"
            {% unless product.available %}disabled{% endunless %}
            class="bg-black text-white rounded-full h-[52px] w-full font-semibold hover:bg-gray-800 transition disabled:bg-gray-300"
          >
            {% if product.available %}
              Add to Cart
            {% else %}
              Sold Out
            {% endif %}
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

<section class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-12" id="ProductTabsSection">
  
  <div class="flex border-b border-gray-200 mb-8 relative" role="tablist">
    <button 
      class="tab-trigger flex-1 pb-4 text-center text-gray-500 font-medium hover:text-black transition border-b-2 border-transparent" 
      data-tab-target="#tab-details">
      Product Details
    </button>
    
    <button 
      class="tab-trigger flex-1 pb-4 text-center text-black font-bold border-b-2 border-black transition" 
      data-tab-target="#tab-reviews">
      Rating & Reviews
    </button>
    
    <button 
      class="tab-trigger flex-1 pb-4 text-center text-gray-500 font-medium hover:text-black transition border-b-2 border-transparent" 
      data-tab-target="#tab-faqs">
      FAQs
    </button>
  </div>

  <div class="tab-main-container">

    <div id="tab-details" class="tab-pane hidden animate-in fade-in duration-300">
      <div class="prose max-w-none py-6">
        <h2 class="text-2xl font-bold mb-4">Product Specifications</h2>
        <div class="text-gray-600 leading-relaxed">
          {{ product.description }}
        </div>
      </div>
    </div>

    <div id="tab-reviews" class="tab-pane animate-in fade-in duration-300">
      <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
        <div class="flex items-center gap-2">
          <h2 class="text-2xl font-bold">All Reviews</h2>
          <span class="text-gray-500 text-sm">(451)</span>
        </div>
        
        <div class="flex items-center gap-3">
          <button class="p-3 bg-gray-100 rounded-full hover:bg-gray-200 transition" aria-label="Filter reviews">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M11 19V11H3V19H11ZM11 7V5H3V7H11ZM21 19V17H13V19H21ZM21 7V15H13V7H21Z" fill="black"/>
            </svg>
          </button>
          
          <div class="relative">
            <select class="appearance-none bg-gray-100 pl-6 pr-12 py-3 rounded-full font-medium focus:outline-none cursor-pointer">
              <option>Latest</option>
              <option>Oldest</option>
              <option>Highest Rated</option>
            </select>
          </div>

          <button class="bg-black text-white px-6 py-3 rounded-full font-medium hover:bg-gray-800 transition">
            Write a Review
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="ReviewsGrid">
        {% for i in (1..6) %}
          <div class="border border-gray-200 rounded-[20px] p-6 flex flex-col gap-3">
            <div class="flex justify-between items-start">
              <div class="flex text-yellow-400">
                {% for star in (1..5) %}
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                {% endfor %}
              </div>
              <button class="text-gray-400 hover:text-black">•••</button>
            </div>
            
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-lg">Reviewer Name {{ i }}</h3>
              <span class="bg-green-500 text-white rounded-full p-0.5">
                 <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              </span>
            </div>

            <p class="text-gray-600 leading-relaxed">
              "This {{ product.title }} is exactly what I was looking for. The fit is perfect and the quality is outstanding."
            </p>
            
            <p class="text-gray-400 text-sm mt-2 font-medium">Posted on {{ 'now' | date: "%B %d, %Y" }}</p>
          </div>
        {% endfor %}
      </div>

      <div class="flex justify-center mt-10">
        <button id="LoadMoreAction" class="px-10 py-4 border border-gray-200 rounded-full font-bold hover:bg-gray-50 transition">
          Load More Reviews
        </button>
      </div>
    </div>

    <div id="tab-faqs" class="tab-pane hidden animate-in fade-in duration-300">
      <div class="py-6 max-w-2xl">
        <h2 class="text-2xl font-bold mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <details class="group border-b border-gray-100 pb-4 cursor-pointer">
            <summary class="flex justify-between items-center font-bold list-none">
              How does the {{ product.title }} fit?
              <span class="transition group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-3 text-gray-600">Our items generally run true to size. Please refer to the size chart for exact measurements.</p>
          </details>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const triggers = document.querySelectorAll('.tab-trigger');
  const panes = document.querySelectorAll('.tab-pane');

  triggers.forEach(trigger => {
    trigger.addEventListener('click', function() {
      const targetSelector = this.getAttribute('data-tab-target');
      const targetPane = document.querySelector(targetSelector);

      // 1. Update Header UI
      triggers.forEach(t => {
        t.classList.remove('text-black', 'font-bold', 'border-black');
        t.classList.add('text-gray-500', 'font-medium', 'border-transparent');
      });
      this.classList.add('text-black', 'font-bold', 'border-black');
      this.classList.remove('text-gray-500', 'font-medium', 'border-transparent');

      // 2. Switch Content Panes
      panes.forEach(pane => pane.classList.add('hidden'));
      targetPane.classList.remove('hidden');
    });
  });

  // Load More Simulation
  const loadMoreBtn = document.getElementById('LoadMoreAction');
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', function() {
      this.textContent = 'Loading...';
      setTimeout(() => {
        this.textContent = 'No more reviews to show';
        this.classList.add('opacity-50', 'cursor-not-allowed');
      }, 1000);
    });
  }
});
</script>

<style>
  /* Ensure smooth transitions */
  .tab-pane.hidden { display: none; }
  .animate-in { animation: fadeIn 0.4s ease-out; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const mainImage = document.getElementById("MainProductImage");
  const thumbs = document.querySelectorAll(".thumbnail-btn");

  thumbs.forEach(btn => {
    btn.addEventListener("click", () => {
      mainImage.src = btn.dataset.imageUrl;

      thumbs.forEach(t => t.classList.remove("border-black"));
      btn.classList.add("border-black");
    });
  });
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const productForm = document.querySelector('.product-form');
  const qtyInput = productForm?.querySelector('input[name="quantity"]');
  const minusBtn = productForm?.querySelector('[data-qty-btn="minus"]');
  const plusBtn = productForm?.querySelector('[data-qty-btn="plus"]');
  const variantInput = productForm?.querySelector('input[name="id"]');

  if (minusBtn && plusBtn && qtyInput) {
    // Get max quantity from Shopify inventory
    const getMaxQuantity = () => {
      const variantId = variantInput?.value;
      // Shopify will validate this on submission, set a reasonable default
      return 999;
    };

    minusBtn.addEventListener("click", function (e) {
      e.preventDefault();
      let currentValue = parseInt(qtyInput.value) || 1;
      if (currentValue > 1) {
        qtyInput.value = currentValue - 1;
      }
    });

    plusBtn.addEventListener("click", function (e) {
      e.preventDefault();
      let currentValue = parseInt(qtyInput.value) || 1;
      const maxQty = getMaxQuantity();
      if (currentValue < maxQty) {
        qtyInput.value = currentValue + 1;
      }
    });

    // Validate input on change
    qtyInput.addEventListener("change", function () {
      let value = parseInt(this.value) || 1;
      if (value < 1) {
        this.value = 1;
      }
    });
  }

  // Handle form submission with Shopify cart
  if (productForm) {
    productForm.addEventListener("submit", function (e) {
      const qtyValue = parseInt(qtyInput?.value) || 1;
      if (qtyValue < 1) {
        e.preventDefault();
        alert("Please select a valid quantity");
        return false;
      }
    });
  }
});
</script>


