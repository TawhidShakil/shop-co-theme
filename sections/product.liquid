<section class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 font-satoshi" id="ProductSection-{{ section.id }}">
  
  <nav class="flex items-center text-sm text-gray-500 mb-8 gap-2">
    <a href="/" class="hover:text-black transition">Home</a>
    <span class="text-gray-400">/</span>
    <a href="/collections/all" class="hover:text-black transition">Shop</a>
    <span class="text-gray-400">/</span>
    <span class="text-black capitalize">{{ product.type | default: 'T-shirts' }}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

    <div class="flex flex-col-reverse md:flex-row gap-4">
      <div class="flex md:flex-col gap-4 w-full md:w-24 overflow-x-auto">
         {% for image in product.images %}
          <button 
            class="thumbnail-btn flex-shrink-0 border-2 rounded-2xl overflow-hidden transition-all duration-200 aspect-square {% if forloop.first %}border-black{% else %}border-gray-100{% endif %}"
            data-image-url="{{ image | img_url: '800x' }}">
            <img src="{{ image | img_url: '200x200', crop: 'center' }}" alt="{{ image.alt }}" class="w-full h-full object-cover">
          </button>
        {% endfor %}
      </div>

      <div class="flex-1 bg-[#F0EEED] rounded-[20px] overflow-hidden flex items-center justify-center">
        <img
          id="MainProductImage"
          src="{{ product.featured_image | img_url: '1200x' }}"
          alt="{{ product.title }}"
          class="w-full h-auto object-cover mix-blend-multiply"
        >
      </div>
    </div>

    <div class="flex flex-col gap-3">
      <h1 class="text-3xl md:text-5xl font-black uppercase tracking-tight leading-none mb-1">
        {{ product.title }}
      </h1>

      <div class="flex items-center gap-3">
        <div class="flex text-[#FFC633]">
          {% for i in (1..5) %}
            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          {% endfor %}
        </div>
        <span class="text-sm font-medium">4.5/<span class="text-gray-400">5</span></span>
      </div>

      <div class="flex items-center gap-3 mt-2">
        <span class="text-3xl font-bold">{{ product.selected_or_first_available_variant.price | money_without_trailing_zeros }}</span>
        
        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
          <span class="text-3xl font-bold text-gray-300 line-through">
            {{ product.selected_or_first_available_variant.compare_at_price | money_without_trailing_zeros }}
          </span>
          <span class="bg-[#FF33331A] text-[#FF3333] text-sm font-medium px-4 py-1.5 rounded-full">
            -{{ product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | times: 100 | divided_by: product.selected_or_first_available_variant.compare_at_price }}%
          </span>
        {% endif %}
      </div>

      <p class="text-gray-500 text-base leading-relaxed mt-2 border-b border-gray-100 pb-6">
        {{ product.description }}
      </p>

      {% form 'product', product, class: 'mt-4 flex flex-col gap-6' %}
        {% for option in product.options_with_values %}
          <div class="flex flex-col gap-3">
            <h3 class="text-gray-500 font-normal">Select {{ option.name }}</h3>
            <div class="flex flex-wrap gap-3">
              {% for value in option.values %}
                <label class="cursor-pointer relative">
                  <input type="radio" name="{{ option.name }}" value="{{ value }}" class="hidden peer" {% if option.selected_value == value %}checked{% endif %}>
                  
                  {% if option.name == 'Color' or option.name == 'Colour' %}
                    {% capture color_style %}{% case value | downcase %}{% when 'olive' %}#4F4E33{% when 'forest' %}#314F4A{% when 'navy' %}#31344F{% else %}{{ value }}{% endcase %}{% endcapture %}
                    <span class="block w-10 h-10 rounded-full border border-black/10 transition-all peer-checked:ring-1 peer-checked:ring-black peer-checked:ring-offset-2 flex items-center justify-center" style="background-color: {{ color_style }};">
                      <svg class="w-4 h-4 text-white opacity-0 peer-checked:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                    </span>
                  {% else %}
                    <span class="px-6 py-3 bg-[#F0F0F0] rounded-full text-gray-600 transition-all peer-checked:bg-black peer-checked:text-white block">
                      {{ value }}
                    </span>
                  {% endif %}
                </label>
              {% endfor %}
            </div>
          </div>
        {% endfor %}

        <div class="flex gap-4 pt-4 border-t border-gray-100">
          <div class="flex items-center justify-between bg-[#F0F0F0] rounded-full w-32 md:w-40 px-5 py-3">
            <button type="button" class="text-2xl font-light">−</button>
            <input type="number" name="quantity" value="1" class="bg-transparent text-center w-8 border-none focus:ring-0 font-bold">
            <button type="button" class="text-2xl font-light">+</button>
          </div>

          <button type="submit" class="flex-1 bg-black text-white rounded-full font-bold hover:bg-zinc-800 transition py-4">
            Add to Cart
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</section>
<div id="ProductJson-{{ section.id }}-container" data-section-id="{{ section.id }}">
<script type="application/json" id="ProductJson-{{ section.id }}">
{
  "variants": [
    {% for variant in product.variants %}
    {
      "id": {{ variant.id }},
      "option1": {{ variant.option1 | json }},
      "option2": {{ variant.option2 | json }},
      "option3": {{ variant.option3 | json }},
      "price": {{ variant.price }},
      "compare_at_price": {{ variant.compare_at_price | default: 0 }},
      "price_formatted": {{ variant.price | money | json }},
      "compare_at_price_formatted": {{ variant.compare_at_price | money | json }},
      "available": {{ variant.available | json }},
      "featured_image": {% if variant.featured_image %}{
        "src": "{{ variant.featured_image | img_url: '1200x' }}",
        "alt": {{ variant.featured_image.alt | default: product.title | json }},
        "id": {{ variant.featured_image.id }}
      }{% else %}null{% endif %}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "option_names": [{% for option in product.options_with_values %}{{ option.name | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]
}
</script>
</div>

<section class="max-w-[1240px] mx-auto px-3 sm:px-6 lg:px-8 py-8 sm:py-12" id="ProductTabsSection">
  
  <div class="flex flex-col sm:flex-row border-b border-gray-200 mb-8 relative overflow-x-auto" role="tablist">
    <button 
      class="tab-trigger flex-1 min-w-0 py-3 sm:pb-4 px-2 text-center text-xs sm:text-base text-gray-500 font-medium hover:text-black transition border-b-2 border-transparent whitespace-nowrap" 
      data-tab-target="#tab-details">
      Product Details
    </button>
    
    <button 
      class="tab-trigger flex-1 min-w-0 py-3 sm:pb-4 px-2 text-center text-xs sm:text-base text-black font-bold border-b-2 border-black transition whitespace-nowrap" 
      data-tab-target="#tab-reviews">
      Rating & Reviews
    </button>
    
    <button 
      class="tab-trigger flex-1 min-w-0 py-3 sm:pb-4 px-2 text-center text-xs sm:text-base text-gray-500 font-medium hover:text-black transition border-b-2 border-transparent whitespace-nowrap" 
      data-tab-target="#tab-faqs">
      FAQs
    </button>
  </div>

  <div class="tab-main-container">

    <div id="tab-details" class="tab-pane hidden animate-in fade-in duration-300">
      <div class="prose max-w-none py-4 sm:py-6">
        <h2 class="text-xl sm:text-2xl font-bold mb-4">Product Specifications</h2>
        <div class="text-gray-600 leading-relaxed">
          {{ product.description }}
        </div>
      </div>
    </div>

    <div id="tab-reviews" class="tab-pane animate-in fade-in duration-300">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div class="flex items-center gap-2">
          <h2 class="text-xl sm:text-2xl font-bold">All Reviews</h2>
          <span class="text-gray-500 text-sm">(451)</span>
        </div>
        
        <div class="flex flex-wrap items-center gap-2 sm:gap-3">
          <button class="p-3 bg-gray-100 rounded-full hover:bg-gray-200 transition" aria-label="Filter reviews">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M11 19V11H3V19H11ZM11 7V5H3V7H11ZM21 19V17H13V19H21ZM21 7V15H13V7H21Z" fill="black"/>
            </svg>
          </button>
          
          <div class="relative">
            <select class="appearance-none bg-gray-100 pl-6 pr-12 py-3 rounded-full font-medium focus:outline-none cursor-pointer">
              <option>Latest</option>
              <option>Oldest</option>
              <option>Highest Rated</option>
            </select>
          </div>

          <button class="bg-black text-white px-4 sm:px-6 py-2.5 sm:py-3 rounded-full text-sm sm:text-base font-medium hover:bg-gray-800 transition w-full sm:w-auto">
            Write a Review
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="ReviewsGrid">
        {% for i in (1..6) %}
          <div class="border border-gray-200 rounded-xl sm:rounded-[20px] p-4 sm:p-6 flex flex-col gap-3">
            <div class="flex justify-between items-start">
              <div class="flex text-yellow-400">
                {% for star in (1..5) %}
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                {% endfor %}
              </div>
              <button class="text-gray-400 hover:text-black">•••</button>
            </div>
            
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-lg">Reviewer Name {{ i }}</h3>
              <span class="bg-green-500 text-white rounded-full p-0.5">
                 <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
              </span>
            </div>

            <p class="text-gray-600 leading-relaxed">
              "This {{ product.title }} is exactly what I was looking for. The fit is perfect and the quality is outstanding."
            </p>
            
            <p class="text-gray-400 text-sm mt-2 font-medium">Posted on {{ 'now' | date: "%B %d, %Y" }}</p>
          </div>
        {% endfor %}
      </div>

      <div class="flex justify-center mt-8 sm:mt-10">
        <button id="LoadMoreAction" class="px-6 sm:px-10 py-3 sm:py-4 border border-gray-200 rounded-full text-sm sm:text-base font-bold hover:bg-gray-50 transition w-full sm:w-auto max-w-sm sm:max-w-none">
          Load More Reviews
        </button>
      </div>
    </div>

    <div id="tab-faqs" class="tab-pane hidden animate-in fade-in duration-300">
      <div class="py-4 sm:py-6 max-w-2xl">
        <h2 class="text-xl sm:text-2xl font-bold mb-4 sm:mb-6">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <details class="group border-b border-gray-100 pb-4 cursor-pointer">
            <summary class="flex justify-between items-center font-bold list-none">
              How does the {{ product.title }} fit?
              <span class="transition group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-3 text-gray-600">Our items generally run true to size. Please refer to the size chart for exact measurements.</p>
          </details>
        </div>
      </div>
    </div>

  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const triggers = document.querySelectorAll('.tab-trigger');
  const panes = document.querySelectorAll('.tab-pane');

  triggers.forEach(trigger => {
    trigger.addEventListener('click', function() {
      const targetSelector = this.getAttribute('data-tab-target');
      const targetPane = document.querySelector(targetSelector);

      // 1. Update Header UI
      triggers.forEach(t => {
        t.classList.remove('text-black', 'font-bold', 'border-black');
        t.classList.add('text-gray-500', 'font-medium', 'border-transparent');
      });
      this.classList.add('text-black', 'font-bold', 'border-black');
      this.classList.remove('text-gray-500', 'font-medium', 'border-transparent');

      // 2. Switch Content Panes
      panes.forEach(pane => pane.classList.add('hidden'));
      targetPane.classList.remove('hidden');
    });
  });

  // Load More Simulation
  const loadMoreBtn = document.getElementById('LoadMoreAction');
  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', function() {
      this.textContent = 'Loading...';
      setTimeout(() => {
        this.textContent = 'No more reviews to show';
        this.classList.add('opacity-50', 'cursor-not-allowed');
      }, 1000);
    });
  }
});
</script>

<style>
  /* Ensure smooth transitions */
  .tab-pane.hidden { display: none; }
  .animate-in { animation: fadeIn 0.4s ease-out; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var sectionId = {{ section.id | json }};
  var mainImage = document.getElementById("MainProductImage");
  var thumbs = document.querySelectorAll(".thumbnail-btn");
  var productForm = document.querySelector('#ProductSection-' + sectionId + ' .product-form');
  var variantIdInput = productForm ? productForm.querySelector('input[name="id"]') : null;
  var productJsonEl = document.getElementById('ProductJson-' + sectionId) || document.querySelector('#ProductJson-' + sectionId + '-container script[type="application/json"]');
  var productSection = document.getElementById('ProductSection-' + sectionId);
  var priceEl = productSection ? productSection.querySelector('[data-variant-price]') : document.querySelector('[data-variant-price]');
  var comparePriceEl = productSection ? productSection.querySelector('[data-variant-compare-price]') : document.querySelector('[data-variant-compare-price]');
  var savingsEl = productSection ? productSection.querySelector('[data-variant-savings]') : document.querySelector('[data-variant-savings]');
  var addToCartBtn = productSection ? productSection.querySelector('[data-add-to-cart-btn]') : document.querySelector('[data-add-to-cart-btn]');
  var addToCartText = productSection ? productSection.querySelector('[data-add-to-cart-text]') : document.querySelector('[data-add-to-cart-text]');

  // Thumbnail click: update main image
  if (mainImage && thumbs.length) {
    thumbs.forEach(btn => {
      btn.addEventListener("click", () => {
        mainImage.src = btn.dataset.imageUrl;
        thumbs.forEach(t => t.classList.remove("border-black"));
        btn.classList.add("border-black");
      });
    });
  }

  // Variant switching: image, price, add-to-cart
  if (productJsonEl && productForm && variantIdInput) {
    var productData;
    try {
      productData = JSON.parse(productJsonEl.textContent);
    } catch (e) {
      console.warn('Product JSON parse error:', e);
      return;
    }

    var optionNames = productData.option_names || productData.options || [];

    function getSelectedOptions() {
      var selected = [];
      for (var i = 0; i < optionNames.length; i++) {
        var name = optionNames[i];
        var input = productForm.querySelector('input[name="' + CSS.escape(name) + '"]:checked, select[name="' + CSS.escape(name) + '"]');
        selected.push(input ? input.value : null);
      }
      return selected;
    }

    function findVariant(selectedOptions) {
      var opts = selectedOptions || [];
      var list = productData.variants || [];
      for (var i = 0; i < list.length; i++) {
        var v = list[i];
        var o1 = String(v.option1 || '').toLowerCase();
        var o2 = String(v.option2 || '').toLowerCase();
        var o3 = String(v.option3 || '').toLowerCase();
        var s1 = String(opts[0] || '').toLowerCase();
        var s2 = String(opts[1] || '').toLowerCase();
        var s3 = String(opts[2] || '').toLowerCase();
        if ((!s1 || o1 === s1) && (!s2 || o2 === s2) && (!s3 || o3 === s3)) {
          return v;
        }
      }
      return null;
    }

    function syncThumbnailBorder(imageId) {
      for (var i = 0; i < thumbs.length; i++) {
        var btn = thumbs[i];
        if (String(btn.dataset.imageId || '') === String(imageId || '')) {
          btn.classList.add("border-black");
        } else {
          btn.classList.remove("border-black");
        }
      }
    }

    function updateVariant(variant) {
      variantIdInput.value = variant.id;

      if (priceEl) priceEl.textContent = variant.price_formatted || '';

      if (comparePriceEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          comparePriceEl.textContent = variant.compare_at_price_formatted || '';
          comparePriceEl.classList.remove("hidden");
        } else {
          comparePriceEl.classList.add("hidden");
        }
      }

      if (savingsEl) {
        if (variant.compare_at_price && variant.compare_at_price > variant.price) {
          var pct = Math.round(((variant.compare_at_price - variant.price) / variant.compare_at_price) * 100);
          savingsEl.textContent = '-' + pct + '%';
          savingsEl.classList.remove("hidden");
        } else {
          savingsEl.classList.add("hidden");
        }
      }

      if (addToCartBtn) {
        addToCartBtn.disabled = !variant.available;
      }
      if (addToCartText) {
        addToCartText.textContent = variant.available ? 'Add to Cart' : 'Sold Out';
      }

      if (mainImage && variant.featured_image) {
        mainImage.src = variant.featured_image.src;
        mainImage.alt = variant.featured_image.alt || '';
        syncThumbnailBorder(variant.featured_image.id);
      }
    }

    function onVariantChange() {
      var selected = getSelectedOptions();
      var variant = findVariant(selected);
      if (variant) {
        updateVariant(variant);
      }
    }

    function handleOptionInteraction(e) {
  // Force the radio button to be checked if the label/span was clicked
  const label = e.target.closest('label');
  if (label) {
    const input = label.querySelector('input[type="radio"]');
    if (input) input.checked = true;
  }
  onVariantChange();
}

// Ensure you are listening to the correct container
productForm.addEventListener('click', function(e) {
  if (e.target.closest('.color-swatch') || e.target.closest('label')) {
    handleOptionInteraction(e);
  }
});

    productForm.addEventListener('change', function(e) {
      if (e.target.type === 'radio' || (e.target.tagName === 'SELECT' && e.target.name)) {
        handleOptionInteraction();
      }
    });

    productForm.addEventListener('click', function(e) {
      if (e.target.closest && e.target.closest('label') && e.target.closest('label').querySelector('input[type="radio"]')) {
        handleOptionInteraction();
      }
    });

    onVariantChange();
  }
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const productForm = document.querySelector('.product-form');
  const qtyInput = productForm?.querySelector('input[name="quantity"]');
  const minusBtn = productForm?.querySelector('[data-qty-btn="minus"]');
  const plusBtn = productForm?.querySelector('[data-qty-btn="plus"]');
  const variantInput = productForm?.querySelector('input[name="id"]');

  if (minusBtn && plusBtn && qtyInput) {
    // Get max quantity from Shopify inventory
    const getMaxQuantity = () => {
      const variantId = variantInput?.value;
      // Shopify will validate this on submission, set a reasonable default
      return 999;
    };

    minusBtn.addEventListener("click", function (e) {
      e.preventDefault();
      let currentValue = parseInt(qtyInput.value) || 1;
      if (currentValue > 1) {
        qtyInput.value = currentValue - 1;
      }
    });

    plusBtn.addEventListener("click", function (e) {
      e.preventDefault();
      let currentValue = parseInt(qtyInput.value) || 1;
      const maxQty = getMaxQuantity();
      if (currentValue < maxQty) {
        qtyInput.value = currentValue + 1;
      }
    });

    // Validate input on change
    qtyInput.addEventListener("change", function () {
      let value = parseInt(this.value) || 1;
      if (value < 1) {
        this.value = 1;
      }
    });
  }

  // Handle form submission with Shopify cart
  if (productForm) {
    productForm.addEventListener("submit", function (e) {
      const qtyValue = parseInt(qtyInput?.value) || 1;
      if (qtyValue < 1) {
        e.preventDefault();
        alert("Please select a valid quantity");
        return false;
      }
    });
  }
});
</script>



