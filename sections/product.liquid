<section class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-6" id="ProductSection-{{ section.id }}">
  
  <!-- Breadcrumb -->
  <nav class="flex text-sm text-gray-400 mb-6 space-x-4">
    <a href="/" class="hover:text-black transition">Home</a>
    <span>›</span>
    <a href="/collections/all" class=" gap-4 hover:text-black transition ">Shop</a>
    <span class="gap-4">›</span>
    
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-10">

    <!-- LEFT: Images -->
    <div class="flex flex-col-reverse md:flex-row gap-4">

      <!-- Thumbnails -->
      <div class="flex md:flex-col gap-3 w-full md:w-20 overflow-x-auto">
         {% for image in product.images %}
          <button 
            class="thumbnail-btn flex-shrink-0 border-2 rounded-xl overflow-hidden transition-all duration-200 {% if forloop.first %}border-black{% else %}border-transparent{% endif %}"
            data-image-url="{{ image | img_url: '800x' }}">
            <img src="{{ image | img_url: '150x150', crop: 'center' }}" alt="{{ image.alt }}" class="w-16 h-16 md:w-full md:h-20 object-cover">
          </button>
        {% endfor %}
      </div>

      <!-- Main Image -->
      <div class="flex-1  rounded-3xl overflow-hidden">
        <img
          id="MainProductImage"
          src="{{ product.featured_image | img_url: '1200x' }}"
          alt="{{ product.title }}"
          class="w-full h-full  p-10"
        >
      </div>
    </div>

    <!-- RIGHT: Product Info -->
    <div class= "w-full max-h-full flex flex-1 flex-col justify-between">

      <!-- Title -->
      <h1 class="font-integral text-[40px]  font-integral--color  text-product-title-desktop--line-height">
        {{ product.title }}
      </h1>

      <!-- Rating -->
      <div class="flex items-center  gap-2 mb-2 w-[193px] w-[24px]">
        <div class="flex text-yellow-400 mb-1">
          {% for i in (1..5) %}
            <svg class="w-6 h-8 sm:w-5 sm:h-5 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          {% endfor %}
        </div>
        <span class="text-gray-500 text-sm mb-4">4.5/5</span>
      </div>

      <!-- Price -->
      <div class="flex items-center gap-4  h-[33px]">
        <span class="text-product-price-desktop font-satoshi font-satoshi--weight text-[32px]">
          {{ product.price | money }}
        </span>

        {% if product.compare_at_price > product.price %}
          <span class="text-gray-400 line-through text-[32px] font-satoshi-discount">
            {{ product.compare_at_price | money }}
          </span>

          <span class="bg-red-100 text-red-500 text-sm px-3 py-1 rounded-full font-satoshi-percentage">
            -{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%
          </span>
        {% endif %}
      </div>

     <p class="text-gray-500 text-[16px]  w-[590px] h-auto h-[33px]">
  {{ product.description | strip_html | truncatewords: 30 }}
</p>

<hr class=" leading-6border-t-4 border-gray-200  w-[590px]">

      <!-- Product Form -->
      {% form 'product', product, class: 'product-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

        {% for option in product.options_with_values %}
          <div class=" min-h-[20px] ">
            <h3 class=" text-[16px]  text-gray-500 mb-1">
              {{ option.name }}
            </h3>

            <div class="flex gap-3 flex-wrap">
              {% for value in option.values %}
                <label class="cursor-pointer">
                  <input
                    type="radio"
                    name="{{ option.name }}"
                    value="{{ value }}"
                    class="hidden peer"
                    {% if option.selected_value == value %}checked{% endif %}
                  >

                  {% if option.name contains 'Color' or option.name contains 'Colour' %}
                    <span
                      class="w-10 h-10 rounded-full border border-gray-200 ring-2 ring-transparent ring-offset-2 peer-checked:ring-black block"
                      style="background-color: {{ value | handle }};">
                    </span>
                  {% else %}
                    <span class="px-6 py-2.5 bg-gray-100 rounded-full text-sm font-medium text-gray-700 peer-checked:bg-black peer-checked:text-white">
                      {{ value }}
                    </span>
                  {% endif %}
                </label>
              {% endfor %}
            </div>
          </div>
        {% endfor %}

        <hr class="border-gray-200 mb-6">

        <!-- Quantity + Button -->
        <div class="flex flex-col sm:flex-row items-center gap-4">

          <!-- Quantity -->
          <div class="flex items-center justify-between bg-gray-100 rounded-full h-[52px] w-full sm:w-[170px] px-6">
            <button type="button" data-qty-btn="minus" class="text-xl font-bold">−</button>
            <input type="number" name="quantity" value="1" min="1" class="bg-transparent text-center w-12 border-none focus:ring-0 font-semibold">
            <button type="button" data-qty-btn="plus" class="text-xl font-bold">+</button>
          </div>

          <!-- Add to Cart -->
          <button
            type="submit"
            {% unless product.available %}disabled{% endunless %}
            class="bg-black text-white rounded-full h-[52px] w-full sm:w-[400px] font-semibold hover:bg-gray-800 transition disabled:bg-gray-300"
          >
            {% if product.available %}
              Add to Cart
            {% else %}
              Sold Out
            {% endif %}
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const mainImage = document.getElementById("MainProductImage");
  const thumbs = document.querySelectorAll(".thumbnail-btn");

  thumbs.forEach(btn => {
    btn.addEventListener("click", () => {
      mainImage.src = btn.dataset.imageUrl;

      thumbs.forEach(t => t.classList.remove("border-black"));
      btn.classList.add("border-black");
    });
  });
});
</script>

{% schema %}
{
  "name": "Custom Product Layout",
  "settings": [],
  "presets": [
    {
      "name": "Custom Product Layout"
    }
  ]
}
{% endschema %}
