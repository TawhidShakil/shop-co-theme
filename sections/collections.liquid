{% comment %}
  This section is used in the list-collections template to render a list of
  collections.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="py-4">
  <h1 class="text-2xl font-semibold mb-6">{{ 'collections.title' | t }}</h1>
</div>

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
  {% for collection in collections %}
    <div class="bg-[#F0EEED] w-full max-w-[280px] rounded-xl p-4 gap-3 flex flex-col items-center text-center group transition-all duration-300 hover:shadow-md">
      <!-- Collection name -->
      <h3 class="text-base font-semibold text-black mb-3">
        {{ collection.title }}
      </h3>

      <div class="w-[220px] h-[180px] flex items-center justify-center bg-transparent rounded-lg overflow-hidden">
        {% if collection.featured_image %}
          <img
            src="{{ collection.featured_image | image_url: width: 500 }}"
            alt="{{ collection.title }}"
            class="max-h-full object-contain transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          >
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag: 'w-full h-full opacity-20' }}
        {% endif %}
      </div>

      <!-- Explore button -->
      <a
        href="{{ collection.url }}"
        class="mt-4 w-full bg-black text-white text-sm font-medium py-2 rounded-lg hover:bg-gray-800 transition"
      >
        Explore
      </a>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "t:labels.grid_item_width",
      "options": [
        { "value": "collections--compact", "label": "t:options.size.small" },
        { "value": "collections--full", "label": "t:options.size.large" }
      ],
      "default": "collections--full"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
