<div class="collection-list py-12">
  <div class="max-w-7xl mx-auto px-4">

    <!-- Header -->
    <div class="mb-8">
      <h4 class="text-2xl font-semibold">
        {{ page_title }}
      </h4>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">

      {% for collection in collections %}
      {% unless collection.handle contains 'frontpage' %}

      <div class="bg-white rounded-lg shadow hover:shadow-lg transition">

        <!-- Image -->
        <div class="p-4">
          <div class="w-full aspect-square overflow-hidden rounded-md">
            {% if collection.featured_image != blank and collection.products.first != blank %}
              <img 
                src="{{ collection.featured_image | img_url: 'medium' }}" 
                alt="{{ collection.title }}"
                class="w-full h-full object-cover"
              >
            {% else %}
              <img 
                src="{{ collection.products.first | img_url }}"
                class="w-full h-full object-cover"
              >
            {% endif %}
          </div>
        </div>

        <!-- Footer -->
        <div class="border-t px-4 py-3">
          <h6 class="text-sm font-medium">
            {{ collection.title | escape | link_to: collection.url }}
          </h6>
        </div>

      </div>

      {% endunless %}
      {% endfor %}

    </div>
  </div>
</div>