<section class="full-width bg-[#f4f4f4]  lg:px-[100px]">
  <div class="max-w-[1440px] flex flex-col md:flex-row ">
    <!-- LEFT -->
    <div class="w-full md:w-[650px] lg:w-[750px] flex flex-col gap-4 text-left px-2 md:py-12 lg:py-16 ">
      <!-- Heading -->
      <h1 class="text-hero-desktop font-integral text-[36px] text-center md:text-left md:text-5xl lg:text-6xl">
        {{ section.settings.heading }}
      </h1>

      <!-- Paragraph -->
      <p
        class="
          text-center md:text-left
          text-[#6b7280]
          text-sm
          sm:text-base
          leading-relaxed
          max-w-xl
          mx-auto
          lg:mx-0
        "
      >
        {{ section.settings.subtext }}
      </p>

      <!-- Button -->
      {% if section.settings.button_label != blank %}
        <button
          href="{{ section.settings.button_link }}"
          class="
            w-full md:max-w-[210px] max-h-[52px]
            inline-flex
            justify-center
            items-center
            bg-black
            text-white
            px-8
            py-2
            rounded-full
            text-sm
            font-medium
            transition
          "
        >
          {{ section.settings.button_label }}
        </button>
      {% endif %}

      <!-- Stats -->
      <div class="">
        <div class="grid grid-cols-2 lg:grid-cols-3 text-center lg:text-left font-satoshi">
          {% for block in section.blocks %}
            <div
              class="
                {% if forloop.index == 3 %}
                  col-span-2 lg:col-span-1
                {% endif %}
              "
            >
              <h3 class="text-[22px] lg:text-[28px] font-bold text-[#2b2b2b]">
                {{ block.settings.stat_number }}
              </h3>

              <p class="text-xs lg:text-sm text-gray-500 mt-1">
                {{ block.settings.stat_label }}
              </p>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- IMAGE -->
    <div class="flex">
      {% if section.settings.hero_image %}
        <img
          src="{{ section.settings.hero_image | image_url: width: 2000 }}"
          alt="Hero Image"
          class="
            w-full
            h-full

            object-fit
          "
        >
      {% endif %}
      <!-- Star -->
      <svg
        class="
          absolute
          top-100 right-12
          md:top-12 md:right-20
          lg:top-24 lg:right-42 w-10 h-10 text-yellow-400
        "
        fill="black"
        viewBox="0 0 24 24"
      >
        <path d="M12 .587l3.668 7.431L24 9.748l-6 5.845 1.416 8.262L12 19.771l-7.416 4.084L6 15.593 0 9.748l8.332-1.73z"/>
      </svg>

      <svg
        class="
          absolute top-118 right-72
          md:top-36 md:right-100
          lg:top-52 lg:right-[544px] w-10 h-10 text-yellow-400
        "
        fill="black"
        viewBox="0 0 24 24"
      >
        <path d="M12 .587l3.668 7.431L24 9.748l-6 5.845 1.416 8.262L12 19.771l-7.416 4.084L6 15.593 0 9.748l8.332-1.73z"/>
      </svg>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Fashion Hero Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIND CLOTHES THAT MATCHES YOUR STYLE"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Browse through our diverse range of meticulously crafted garments, designed to bring out your individuality and cater to your sense of style."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "stat_number",
          "label": "Number",
          "default": "200+"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Label",
          "default": "International Brands"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Fashion Hero",
      "blocks": [{ "type": "stat" }, { "type": "stat" }, { "type": "stat" }]
    }
  ]
}
{% endschema %}
