<!-- Top div -->
<section class="full-width max-w-[1440px] md:px-[70px] lg:px-[100px]">
  <div class="flex flex-col sm:flex-row justify-between items-center bg-black rounded-xl max-w-[1240px] min-h-[180px] px-2 sm:px-4 md:px-6 lg:px-8 md:max-w-[872px] lg:max-w-[1240px] md:h-[180px] gap-4 py-4 md:translate-y-24">
    <div class="max-w-[230px] h-full sm:min-w-[280px] md:max-w-[320px] md:max-h-[85px] lg:max-w-[501px] lg:max-h-[94px]">
      <p class="text-2xl lg:text-4xl text-white font-bold text-black">STAY UPTO DATE ABOUT OUR LATEST OFFERS</p>
    </div>

    <div class="max-w-[349px] max-h-[108px] flex flex-col justify-center gap-2">
      <div class="relative w-full flex gap-2 bg-white rounded-full px-4 py-2 text-xs">
        <!-- Email Icon -->
        <svg
          class="w-4 h-4 absolute  text-black"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path stroke-linecap="round" stroke-linejoin="round"
              d="M3 8l9 6 9-6M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <!-- Email Input -->
        <input
          type="email"
          placeholder="Enter Your Email Address"
          class="w-full sm:min-w-[250px] md:min-w-[280px] lg:min-w-[349px] pl-6 bg-transparent outline-none rounded-full"
        >
      </div>
      <button class="bg-white w-full lg:min-w-[349px] rounded-full p-2 text-xs">Subscribe To News</button>
    </div>
  </div>
</section>
<div class="full-width max-w-1440px md:h-[490px] bg-gray-200 flex flex-col gap-3 mx-auto md:pt-[150px] md:px-[70px] lg:px-[100px]">
  <!-- Footer div -->
  <!-- Nav Items div -->
  <div class="max-w-[1240px] min-h-[177px] px-4 sm:px-0 flex justify-between flex-col md:flex-row mx-auto">
    <!-- Logo,des, icon div -->
    <div class="w-full h-auto py-2 sm:py-0 my-auto md:w-[228px] md:min-h-[177px] flex flex-col gap-6">
      {% if section.settings.logo != blank %}
        <img
          src="{{ section.settings.logo | image_url: width: 200 }}"
          alt="{{ shop.name }}"
        >
      {% else %}
        <h6 class="text-2xl font-bold">
          {{ section.settings.logo_text }}
        </h6>
      {% endif %}
      <p class="text-sm">
        {{ section.settings.description }}
      </p>
      <ul class="flex gap-2">
        <!-- Facebook -->
        <li>
          <svg
            class="w-5 h-5 fill-current text-black  hover:text-blue-500 transition"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
          >
            <path d="M22 12a10 10 0 1 0-11.6 9.9v-7H8v-3h2.4V9.7c0-2.4 1.4-3.7 3.6-3.7
            1 0 2 .1 2 .1v2.2h-1.1c-1.1 0-1.4.7-1.4 1.4V12H16l-.4 3h-2.6v7A10 10 0 0 0 22 12z"/>
          </svg>
        </li>

        <!-- Instagram -->
        <li>
          <svg
            class="w-5 h-5 fill-current text-black  hover:text-pink-500 transition"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
          >
            <path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 2 .3 2.5.5
            .6.2 1 .5 1.5 1 .5.5.8.9 1 1.5.2.5.4 1.3.5 2.5
            .1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.3 2-.5 2.5
            -.2.6-.5 1-1 1.5-.5.5-.9.8-1.5 1-.5.2-1.3.4-2.5.5
            -1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-2-.3-2.5-.5
            -.6-.2-1-.5-1.5-1-.5-.5-.8-.9-1-1.5-.2-.5-.4-1.3-.5-2.5
            -.1-1.2-.1-1.6-.1-4.8s0-3.6.1-4.8c.1-1.2.3-2 .5-2.5
            .2-.6.5-1 1-1.5.5-.5.9-.8 1.5-1 .5-.2 1.3-.4 2.5-.5
            1.2-.1 1.6-.1 4.8-.1zm0 3.5a6.3 6.3 0 1 0 0 12.6
            6.3 6.3 0 0 0 0-12.6zm0 10.4a4.1 4.1 0 1 1 0-8.2
            4.1 4.1 0 0 1 0 8.2zm6.6-10.8a1.5 1.5 0 1 1-3 0
            1.5 1.5 0 0 1 3 0z"/>
          </svg>
        </li>

        <!-- X (Twitter) -->
        <li>
          <svg
            class="w-5 h-5 fill-current text-black hover:text-gray-400 transition"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
          >
            <path d="M18.2 2H21l-6.6 7.5L22 22h-6.8l-5.3-7-6.1 7H1
            l7.1-8.1L2 2h6.9l4.8 6.3L18.2 2z"/>
          </svg>
        </li>
      </ul>
    </div>
    <!-- Menu Nav Parent Div -->
    <div class="grid grid-cols-2 md:grid-cols-4 px-4 sm:gap-4 lg:gap-24 py-3 sm:py-0">
      {% for block in section.blocks %}
        <div class="min-w-[104px] min-h-[177px] flex flex-col gap-4" {{ block.shopify_attributes }}>
          <p>{{ block.settings.heading }}</p>

          <ul class="flex flex-col gap-2 text-sm">
            {% for link in block.settings.menu.links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </div>
  <hr>
  <!-- Payemnt Icon & Copy Right Div -->
  <div class="flex flex-col sm:flex-row justify-between gap-2 py-4 px-4 sm:px-0">
    <div class="">
      <p class="text-sm text-center">Shop.co © 2000-2023, All Rights Reserved</p>
    </div>
    <div>
      <ul class="flex gap-2">
        <!-- Visa -->
        <svg class="w-16 h-10" viewBox="0 0 48 16" xmlns="http://www.w3.org/2000/svg">
          <rect width="48" height="16" rx="2" fill="#1A1F71"/>
          <text x="24" y="12" fill="white" font-size="10" font-weight="bold" text-anchor="middle">VISA</text>
        </svg>

        <!-- Mastercard -->
        <svg class="w-16 h-10" viewBox="0 0 48 16" xmlns="http://www.w3.org/2000/svg">
          <rect width="48" height="16" rx="2" fill="#000"/>
          <circle cx="22" cy="8" r="5" fill="#EB001B"/>
          <circle cx="26" cy="8" r="5" fill="#F79E1B"/>
        </svg>

        <!-- American Express -->
        <svg class="w-16 h-10" viewBox="0 0 48 16" xmlns="http://www.w3.org/2000/svg">
          <rect width="48" height="16" rx="2" fill="#2E77BB"/>
          <text x="24" y="12" fill="white" font-size="7" font-weight="bold" text-anchor="middle">AMEX</text>
        </svg>

        <!-- PayPal -->
        <svg class="w-16 h-10" viewBox="0 0 48 16" xmlns="http://www.w3.org/2000/svg">
          <rect width="48" height="16" rx="2" fill="#003087"/>
          <text x="24" y="12" fill="white" font-size="7" font-weight="bold" text-anchor="middle">PayPal</text>
        </svg>

        <!-- Apple Pay -->
        <svg class="w-16 h-10" viewBox="0 0 48 16" xmlns="http://www.w3.org/2000/svg">
          <rect width="48" height="16" rx="2" fill="#000"/>
          <text x="24" y="12" fill="white" font-size="7" font-weight="bold" text-anchor="middle"> Pay</text>
        </svg>
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "SHOP.CO"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Store description",
      "default": "We have clothes that suits your style and which you’re proud to wear. From women to men."
    }
  ],
  "blocks": [
    {
      "type": "footer_column",
      "name": "Footer column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Company"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Menu"
    }
  ]
}
{% endschema %}
