<section
  id="AnnouncementBar"
  class="full-width py-2 md:px-[100px] transition-all duration-300"
  style="
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="relative max-w-[1440px] mx-auto flex items-center justify-center px-4">
    <p class="text-xs text-center sm:text-sm">
      {{ section.settings.text }}

      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}" class="underline ml-1">
          {{ section.settings.link_label }}
        </a>
      {% endif %}
    </p>

    <button
      id="CloseAnnouncement"
      aria-label="Close announcement"
      class="hidden md:block absolute right-4"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <path stroke-linecap="round" stroke-linejoin="round"
          d="M6 6L18 18M6 18L18 6"/>
      </svg>
    </button>
  </div>
</section>
<script>
  document.addEventListener("DOMContentLoaded", initAnnouncement);
  document.addEventListener("shopify:section:load", initAnnouncement);

  function initAnnouncement() {
    const bar = document.getElementById("AnnouncementBar");
    const closeBtn = document.getElementById("CloseAnnouncement");

    if (!bar || !closeBtn) return;

    closeBtn.onclick = () => {
      bar.classList.add("hidden");
    };
  }
</script>
{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 15
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Sign up and get 20% off to your first order."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Sign Up"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Learn more"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}
