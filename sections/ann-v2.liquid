<section
  class="full-width py-2"
  style="
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="relative max-w-[1440px] mx-auto flex items-center justify-center px-4">
    <p class="text-xs text-center sm:text-sm">
      {{ section.settings.text }}

      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}" class="underline ml-1">
          {{ section.settings.link_label }}
        </a>
      {% endif %}
    </p>

    <button
      aria-label="Close announcement"
      class="absolute right-4"
    >
      ✕
    </button>
  </div>
</section>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 15
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Sign up and get 20% off to your first order."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Sign Up"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Learn more"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Announcement Bar"
    }
  ]
}
{% endschema %}